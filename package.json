{
  "name": "coronado-bridge",
  "version": "2.4.1",
  "description": "Coronado Bridge is a simple general purpose router of all HTTP requests. It will wrap all RESTful calls from external systems and pass those JSON message into a outbound provider.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/valtech-sd/coronado-bridge.git"
  },
  "scripts": {
    "prepare": "rimraf ./dist && tsc",
    "build": "rm -rf dist && tsc",
    "test": "mocha"
  },
  "author": "Shane Mckenna",
  "license": "MIT",
  "dependencies": {
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.6",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/connect-timeout": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "chai": "^6.3.0",
    "chai-http": "^5.2.1",
    "log4js": "^6.9.1",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "tslog": "^5.4.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
